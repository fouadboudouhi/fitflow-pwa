{
  "name": "volumora-pwa",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-fähige Trainings-PWA ohne Build-Schritt.",
  "scripts": {
    "start": "node tests/serve.js 8080",
    "check": "node --experimental-vm-modules --no-warnings tests/check.mjs",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.{js,mjs}\" sw.js styles.css",
    "lint": "prettier --check \"src/**/*.js\" \"tests/**/*.{js,mjs}\" sw.js styles.css",
    "test": "npm run lint && npm run check && node --test tests/unit.test.mjs tests/smoke.test.js"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "playwright": "1.56.1",
    "prettier": "^3.9.9"
  }
}
